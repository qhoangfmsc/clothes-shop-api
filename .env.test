# Postgres cho flow test (yarn test:flows). Chỉnh khi cổng 55432 bị chiếm hoặc muốn dùng Postgres có sẵn
# (khi đó chạy `yarn test:flows:run`; schema của DB đó bị xoá và dựng lại mỗi lần chạy).
# Đổi xong cần: yarn test:db:down && yarn test:db:up
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USERNAME=test
POSTGRES_PASSWORD=test
# Phải kết thúc bằng _test
POSTGRES_DATABASE=clothes_shop_test
