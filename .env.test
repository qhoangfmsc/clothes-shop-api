# ============================================================================
# CẤU HÌNH FLOW TEST (yarn test:flows) — file này bạn chỉnh khi cần.
# Dùng chung cho Postgres test (docker-compose.test.yml) và cho jest.
# Giá trị ở đây GHI ĐÈ `.env` của app khi chạy flow test.
# Không đặt secret thật (file này được commit). Thiếu khoá nào thì dùng mặc định trong test/support/test-env.ts.
# ============================================================================

# --- Postgres test -----------------------------------------------------------
# Đổi POSTGRES_PORT nếu cổng 55432 đã bị chiếm. Sau khi đổi HOST/PORT/USERNAME/PASSWORD/DATABASE
# cần tắt DB cũ rồi bật lại: yarn test:db:down && yarn test:db:up
# Muốn dùng Postgres có sẵn thay vì docker: trỏ các khoá này tới nó và chạy `yarn test:flows:run`
# (script này không bật docker). Schema của DB đó sẽ bị XOÁ và dựng lại mỗi lần chạy.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USERNAME=test
POSTGRES_PASSWORD=test
# BẮT BUỘC kết thúc bằng _test: chốt chặn để không bao giờ xoá nhầm DB thật
POSTGRES_DATABASE=clothes_shop_test

# --- Xác thực (giá trị giả, chỉ dùng trong test) ------------------------------
JWT_SECRET=flow-test-jwt-secret

# --- Thanh toán SePay (giá trị giả, chỉ dùng trong test) ----------------------
SEPAY_RECEIVING_BANK_CODE=VCB
SEPAY_RECEIVING_BANK_NAME=Vietcombank
SEPAY_RECEIVING_ACCOUNT=0123456789
SEPAY_RECEIVING_ACCOUNT_NAME=DOOVAN TEST
SEPAY_WEBHOOK_SECRET=flow-test-sepay-secret
PAYMENT_TRANSFER_PREFIX=DH

# Lưu ý: SUPABASE_*, GOOGLE_*, STORAGE_URL KHÔNG cấu hình được ở đây. Flow test luôn để rỗng và chặn mạng
# (hermetic) để không bao giờ chạm dịch vụ thật. Khai báo chúng ở đây sẽ làm test báo lỗi.
